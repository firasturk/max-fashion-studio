{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "max-fashion-studio",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "alias": {
    "@shared/config": "./shared/config.ts",
    "@shared/prompts": "./shared/prompts.ts",
    "@shared/naming": "./shared/naming.ts",
    "@shared/types": "./shared/types.ts"
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "max-fashion-studio",
      "database_id": "ce667dc8-3fa1-40ed-adcb-594c03695936",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "max-fashion-studio" }],
  "vars": {
    "HIGGSFIELD_MODEL": "nano-banana-pro",
    "HIGGSFIELD_BASE_URL": "https://api.higgsfield.ai",
    "MAX_CONCURRENT_GENERATIONS": "2",
  },
}
