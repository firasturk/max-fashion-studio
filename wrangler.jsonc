{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "max-fashion-studio",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "alias": {
    "@shared/config": "./shared/config.ts",
    "@shared/config-schema": "./shared/config-schema.ts",
    "@shared/prompts": "./shared/prompts.ts",
    "@shared/naming": "./shared/naming.ts",
    "@shared/types": "./shared/types.ts",
    "@shared/editorial-skill": "./shared/editorial-skill.ts",
    "@shared/pricing": "./shared/pricing.ts",
    "@shared/skills": "./shared/skills.ts",
    "@shared/zaid": "./shared/zaid.ts",
    "@shared/safety": "./shared/safety.ts",
    "@shared/paths": "./shared/paths.ts",
    "@shared/direction-rules": "./shared/direction-rules.ts",
    "@shared/zip-parts": "./shared/zip-parts.ts",
    "@shared/colours": "./shared/colours.ts",
    "@shared/png": "./shared/png.ts",
    "@shared/backdrop": "./shared/backdrop.ts",
  },
  "triggers": { "crons": ["* * * * *"] },
  // Run near the US-hosted engines; Gemini refuses requests from some regions.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "max-fashion-studio",
      "database_id": "ce667dc8-3fa1-40ed-adcb-594c03695936",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "max-fashion-studio" }],
  // One Durable Object per image generation: a batch's whole width starts at once.
  "durable_objects": { "bindings": [{ "name": "RUNNER", "class_name": "ImageRunner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImageRunner"] }],
  // The queue is the fallback fan-out (it scales its consumers up slowly).
  "queues": {
    "producers": [{ "binding": "IMAGES", "queue": "max-fashion-studio-images" }],
    "consumers": [
      {
        "queue": "max-fashion-studio-images",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 40,
        "max_retries": 0,
      },
    ],
  },
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "HIGGSFIELD_MODEL": "nano-banana-pro",
    "HIGGSFIELD_BASE_URL": "https://api.higgsfield.ai",
    "MAX_CONCURRENT_GENERATIONS": "6",
    "VERTEX_PARALLEL": "12",
    "GOOGLE_PARALLEL": "60",
    "GOOGLE_PREFER": "key",
    "PUBLIC_BASE_URL": "https://max-fashion-studio.max-fashion-studio.workers.dev",
  },
}
